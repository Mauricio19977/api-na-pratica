     "response": []
    },
    {
     "name": "4. Conferir a edição (não confie no 200)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"status é 200\", () => pm.response.to.have.status(200));",
         "",
         "const corpo = pm.response.json();",
         "pm.test(\"o nome mudou de verdade\", () =>",
         "  pm.expect(corpo.nome).to.eql(pm.collectionVariables.get(\"nomeCriado\")));",
         "pm.test(\"o perfil mudou de verdade\", () =>",
         "  pm.expect(corpo.administrador).to.eql(\"false\"));"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "usuarios",
        "{{usuarioId}}"
       ]
      }
     },
     "response": []
    },
    {
     "name": "5. Apagar o usuário (limpeza)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"status é 200\", () => pm.response.to.have.status(200));",
         "pm.test(\"apagou de verdade (e não 'nenhum registro')\", () =>",
         "  pm.expect(pm.response.json().message).to.eql(\"Registro excluído com sucesso\"));"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "DELETE",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "usuarios",
        "{{usuarioId}}"
       ]
      }
     },
     "response": []
    },
    {
     "name": "6. Conferir que sumiu",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"consultar o apagado dá 400\", () => pm.response.to.have.status(400));",
         "pm.test(\"mensagem de não encontrado\", () =>",
         "  pm.expect(pm.response.json().message).to.eql(\"Usuário não encontrado\"));",
         "",
         "// Fecha o ciclo: a variável não deve sobreviver ao fluxo.",
         "pm.collectionVariables.unset(\"usuarioId\");",
         "pm.collectionVariables.unset(\"nomeCriado\");",
         "pm.collectionVariables.unset(\"emailCriado\");"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "usuarios",
        "{{usuarioId}}"
       ]
      }
     },
     "response": []
    }
   ]
  }
 ],
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{token}}",
    "type": "string"
   }
  ]
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "// Login automatico: so roda se nao houver token valido guardado",
     "const agora = Date.now();",
     "const validade = Number(pm.environment.get(\"tokenValidoAte\")) || 0;",
     "",
     "if (!pm.environment.get(\"token\") || agora > validade) {",
     "  pm.sendRequest({",
     "    url: pm.environment.get(\"baseUrl\") + \"/login\",",
     "    method: \"POST\",",
     "    header: { \"Content-Type\": \"application/json\" },",
     "    body: { mode: \"raw\", raw: JSON.stringify({",
     "      email: pm.environment.get(\"email\"),",
     "      password: pm.environment.get(\"senha\")",
     "    }) }",
     "  }, (erro, resposta) => {",
     "    if (erro || resposta.code !== 200) {",
     "      throw new Error(\"Login falhou: \" + (erro || resposta.code));  // falha alto, nao em silencio",
     "    }",
     "    const token = resposta.json().authorization.replace(/^Bearer /, \"\");",
     "    pm.environment.set(\"token\", token);",
     "    pm.environment.set(\"tokenValidoAte\", agora + 9 * 60 * 1000);  // 9 min (token dura 10)",
     "  });",
     "}"
    ]
   }
  }
 ]
}
