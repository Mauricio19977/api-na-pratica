  {
   "name": "Aula 12 — Contrato (JSON Schema)",
   "description": "Uma asserção que verifica a forma inteira da resposta.",
   "item": [
    {
     "name": "Login — contrato da resposta",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const schema = {",
         "  type: \"object\",",
         "  required: [\"message\", \"authorization\"],",
         "  properties: {",
         "    message:       { type: \"string\" },",
         "    authorization: { type: \"string\", pattern: \"^Bearer \" }",
         "  },",
         "  additionalProperties: false      // campo novo na resposta = falha (proposital)",
         "};",
         "",
         "pm.test(\"status é 200\", () => pm.response.to.have.status(200));",
         "pm.test(\"resposta cumpre o contrato\", () => pm.response.to.have.jsonSchema(schema));",
         "",
         "pm.environment.set(\"token\", pm.response.json().authorization.replace(/^Bearer /, \"\"));",
         "pm.environment.set(\"tokenValidoAte\", Date.now() + 9 * 60 * 1000);"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{senha}}\"\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/login",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "login"
       ]
      }
     },
     "response": []
    },
    {
     "name": "Listar produtos — contrato da lista",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const schema = {",
         "  type: \"object\",",
         "  required: [\"quantidade\", \"produtos\"],",
         "  properties: {",
         "    quantidade: { type: \"integer\", minimum: 0 },",
         "    produtos: {",
         "      type: \"array\",",
         "      items: {",
         "        type: \"object\",",
         "        required: [\"nome\", \"preco\", \"descricao\", \"quantidade\", \"_id\"],",
         "        properties: {",
         "          nome:       { type: \"string\", minLength: 1 },",
         "          preco:      { type: \"number\", minimum: 0 },   // tipo E faixa",
         "          descricao:  { type: \"string\" },",
         "          quantidade: { type: \"integer\", minimum: 0 },",
         "          _id:        { type: \"string\" }",
         "        },",
         "        additionalProperties: false",
         "      }",
         "    }",
         "  },",
         "  additionalProperties: false",
         "};",
         "",
         "pm.test(\"status é 200\", () => pm.response.to.have.status(200));",
         "pm.test(\"a lista cumpre o contrato\", () => pm.response.to.have.jsonSchema(schema));"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/produtos",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "produtos"
       ]
      }
     },
     "response": []
    }
   ]
  },
  {
   "name": "Aula 13 — Fluxo encadeado e estado",
   "description": "Criar, consultar, editar e apagar passando o identificador de uma requisição para a outra. A última requisição confirma que a limpeza funcionou.",
   "item": [
    {
     "name": "1. Criar usuário",
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// Guarda o que vai ser enviado, para comparar depois com o que a API devolve.",
         "pm.collectionVariables.set(\"nomeCriado\", \"Sirlene do Fluxo\");",
         "pm.collectionVariables.set(\"emailCriado\", \"sirlene.fluxo@qa.com\");"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"status é 201\", () => pm.response.to.have.status(201));",
         "pm.test(\"mensagem de cadastro\", () =>",
         "  pm.expect(pm.response.json().message).to.eql(\"Cadastro realizado com sucesso\"));",
         "",
         "// O ELO DA CORRENTE: guarda o id que a API gerou.",
         "const id = pm.response.json()._id;",
         "pm.test(\"veio um id\", () => pm.expect(id).to.be.a(\"string\").and.not.empty);",
         "pm.collectionVariables.set(\"usuarioId\", id);"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"nome\": \"{{nomeCriado}}\",\n  \"email\": \"{{emailCriado}}\",\n  \"password\": \"teste\",\n  \"administrador\": \"true\"\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/usuarios",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "usuarios"
       ]
      }
     },
     "response": []
    },
    {
     "name": "2. Consultar o usuário criado",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"status é 200\", () => pm.response.to.have.status(200));",
         "",
         "const corpo = pm.response.json();",
         "// Compara com o que FOI ENVIADO, não com texto fixo.",
         "pm.test(\"nome confere com o que foi enviado\", () =>",
         "  pm.expect(corpo.nome).to.eql(pm.collectionVariables.get(\"nomeCriado\")));",
         "pm.test(\"email confere com o que foi enviado\", () =>",
         "  pm.expect(corpo.email).to.eql(pm.collectionVariables.get(\"emailCriado\")));",
         "pm.test(\"o id é o mesmo da criação\", () =>",
         "  pm.expect(corpo._id).to.eql(pm.collectionVariables.get(\"usuarioId\")));"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "usuarios",
        "{{usuarioId}}"
       ]
      }
     },
     "response": []
    },
    {
     "name": "3. Editar o usuário",
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set(\"nomeCriado\", \"Sirlene do Fluxo (editada)\");"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"status é 200\", () => pm.response.to.have.status(200));",
