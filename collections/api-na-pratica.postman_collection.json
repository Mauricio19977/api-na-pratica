         "  pm.expect(pm.response.json().message).to.eql(\"Registro alterado com sucesso\"));"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "PUT",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"nome\": \"{{nomeCriado}}\",\n  \"email\": \"{{emailCriado}}\",\n  \"password\": \"teste\",\n  \"administrador\": \"false\"\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "usuarios",
        "{{usuarioId}}"
       ]
      }
